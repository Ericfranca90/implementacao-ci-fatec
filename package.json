{
  "name": "api-pedidos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src test --max-warnings 0",
    "format:check": "prettier --check src test eslint.config.mjs eslint.security.config.mjs .github/workflows/ci.yml",
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --test test/total.test.mjs",
    "test:integration": "node --test test/http.test.mjs",
    "start": "node dist/server.js",
    "security:check": "eslint --no-config-lookup --config eslint.security.config.mjs src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
